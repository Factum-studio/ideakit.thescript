@startuml
title Основной путь пользователя IDEAKIT

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF2FF
  BorderColor #315A8A
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #A66A00
}

start
:Пользователь запускает Telegram-бота;
:Бот показывает краткое приветствие
и первую доступную идею;

repeat
  :Карточка идеи;
  if (Действие пользователя) then (Следующая идея)
    :Зафиксировать запрос;
    :Отправить следующую
    ещё не показанную идею;
  elseif (Детали)
    :Показать готовый
    структурированный отчёт;
    if (Нужен PDF?) then (Да)
      :Вернуть готовый PDF
      или поставить одно задание;
    endif
  else (Заказать у нас)
    :Получить комментарий;
    :Показать согласие и подтверждение;
    if (Подтверждено?) then (Да)
      :Создать заявку SUBMITTED;
      :Передать ограниченный диалог
      сотруднику агентства;
    else (Нет)
      :Отменить без создания заявки;
    endif
  endif
repeat while (Есть следующая идея?) is (Да)

:Сообщить об исчерпании каталога;
:Уведомить один раз после публикации новых идей;
stop
@enduml
